{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/factory.cmd\" guard stop",
            "commandWindows": "cmd.exe /d /c call \"${PLUGIN_ROOT}/scripts/factory.cmd\" guard stop",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/factory.cmd\" guard compact",
            "commandWindows": "cmd.exe /d /c call \"${PLUGIN_ROOT}/scripts/factory.cmd\" guard compact",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/factory.cmd\" update-check \"${CLAUDE_PLUGIN_ROOT}\"",
            "commandWindows": "cmd.exe /d /c call \"${PLUGIN_ROOT}/scripts/factory.cmd\" update-check \"${PLUGIN_ROOT}\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
