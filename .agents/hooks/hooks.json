{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "g=\"${CLAUDE_PLUGIN_ROOT}/skills/safe-engine/scripts/stop-guard.sh\"; [ -f \"$g\" ] && . \"$g\"; exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "g=\"${CLAUDE_PLUGIN_ROOT}/skills/safe-engine/scripts/compact.sh\"; [ -f \"$g\" ] && . \"$g\"; exit 0",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
