{
  "version": 1,
  "interface": "web",
  "checks": [
    {"id": "unit", "kind": "unit", "argv": ["node", "tests/unit.mjs"], "timeout_seconds": 60},
    {
      "id": "browser",
      "kind": "browser",
      "argv": ["node", "tests/browser.cjs"],
      "timeout_seconds": 120,
      "artifacts": [
        ".factory/outputs/browser/mobile.png",
        ".factory/outputs/browser/mobile-complete.png",
        ".factory/outputs/browser/desktop.png"
      ]
    }
  ],
  "environment_inputs": ["SAFE_PLAYWRIGHT_MODULE", "SAFE_BROWSER_EXECUTABLE", "NODE_OPTIONS"],
  "input_files": [],
  "protected_paths": ["tests/unit.mjs", "tests/browser.cjs"]
}
