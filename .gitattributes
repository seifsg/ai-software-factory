# Scripts keep the line endings stored in Git on every checkout: POSIX sh fails on CRLF, cmd.exe needs it.
# -text, not eol=: a clone must match the download, which Anthropic's directory checks.
*.sh -text
tools/night/pre-push -text
*.cmd -text
*.png -text
# Bundled binaries, their checksums and the parity corpus keep their bytes: the guard reads them as stored.
.agents/scripts/SHA256SUMS -text
.agents/scripts/SOURCE -text
.agents/scripts/factory-* -text
factory/parity/** -text
factory/tests/fixtures/** -text
